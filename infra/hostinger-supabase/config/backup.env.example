# Copy to /etc/crm-supabase/backup.env and chmod 600.

INSTALL_DIR=/opt/crm-supabase
BACKUP_DIR=/var/backups/crm-supabase
LOCAL_RETENTION_DAYS=2
MAX_BACKUP_AGE_HOURS=8

# Default de producao: backup recorrente externo via Restic. O modo alternativo
# managed-source-cold so pode ser usado quando o projeto Supabase abaixo ficar
# congelado como copia fria de rollback e existir o marcador root/0600 aprovado.
BACKUP_MODE=restic-offsite
COLD_BACKUP_PROJECT_REF=uxttihjsxfowursjyult
COLD_BACKUP_APPROVAL_FILE=/etc/crm-supabase/managed-source-cold-approved

# chat-media retention health thresholds. The hourly timer has up to 5 minutes
# of jitter; alert if a successful run is missing for 2.5h, if any object is
# still present 75min beyond the seven-day cutoff, or if the eligible aggregate
# backlog exceeds two default runs (2 x 2,000 objects).
RETENTION_LAST_SUCCESS_MAX_MINUTES=150
RETENTION_BACKLOG_GRACE_MINUTES=75
RETENTION_ELIGIBLE_MAX_OBJECTS=4000
RETENTION_INITIAL_GRACE_MINUTES=60

# Restic repository. S3-compatible example:
RESTIC_REPOSITORY=s3:https://S3_ENDPOINT/BUCKET/crm-supabase
RESTIC_PASSWORD_FILE=/etc/crm-supabase/restic-password
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
AWS_DEFAULT_REGION=auto

# This is only a non-secret evidence reference. Before enabling timers, add a
# second Restic recovery key with a different password, escrow that password and
# the S3 recovery access outside the VPS/repository, then record the key ID and
# password-manager/offline packet reference here. Never place either password in
# this file.
RESTIC_RECOVERY_KEY_ID=REPLACE_WITH_SECOND_RESTIC_KEY_ID
RECOVERY_ESCROW_RECORD_ID=REPLACE_WITH_EXTERNAL_ESCROW_RECORD_ID

# Optional alert receiver. Leave empty to log only to systemd journal.
ALERT_WEBHOOK_URL=
