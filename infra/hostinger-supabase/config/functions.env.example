# Copy to /opt/crm-supabase/functions.env and chmod 600.
# Never commit the populated file.

# Custom authentication / scheduled jobs
ADMIN_JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX
OAUTH_STATE_SECRET=REPLACE_WITH_64_RANDOM_HEX
CRON_SECRET=REPLACE_WITH_64_RANDOM_HEX
REQUIRE_CRON_SECRET=true

# Functions exempt from the platform-level JWT check. Each endpoint must still
# enforce its own user/admin/webhook/cron authentication exactly as in code.
EDGE_JWT_EXEMPT_FUNCTIONS=admin-auth,admin-create-user,admin-panel-rpc,admin-reset-password,admin-generate-temp-password,admin-manage-admins,mercadopago-webhook,facebook-leads-webhook,facebook-oauth-callback,facebook-oauth-initiate,form-webhook,whatsapp-message-webhook,whatsapp-qr-webhook,whatsapp-status-webhook,add-organization-member,update-organization-member,admin-delete-user,create-whatsapp-instance,disconnect-whatsapp-instance,delete-whatsapp-instance,send-whatsapp-media,send-whatsapp-reaction,set-whatsapp-presence,sync-all-profile-pictures,cleanup-invalid-instances,cleanup-whatsapp-orphans,fix-webhook-config,fix-webhook-config-v2,test-webhook-evolution,send-scheduled-reminders,auto-recurring-blocks,auto-redistribute-leads,check-subscription,get-signed-media-url,notify-new-lead-group,google-calendar-oauth-callback,analise-credito-submit,apr-submit,benchmark-download-submit,disc-dashboard,disc-submit,google-sheets-oauth-callback,sync-google-sheets

# Maintenance/test endpoints and the integrations intentionally postponed for
# this cutover remain on disk for traceability but are not routable. Remove a
# name only after its credentials, callback and authentication path pass a
# controlled validation.
EDGE_DISABLED_FUNCTIONS=test-webhook-evolution,test-webhook-manual,test-webhook-payload,simulate-webhook-message,fix-subscription-constraint,backfill-campaign-names,fix-webhook-config,fix-webhook-config-v2,process-webhook-queue,facebook-leads-backfill,meta-event,create-calendar-event,delete-calendar-event,list-calendar-events,update-calendar-event,google-calendar-oauth-initiate,google-calendar-oauth-callback,google-sheets-oauth-initiate,google-sheets-oauth-callback,sync-google-sheets,sync-google-sheets-meta,create-checkout,update-subscription,mercadopago-webhook,admin-generate-temp-password,admin-reset-password

# Public URLs
SITE_URL=https://www.kairozcrm.com.br
OAUTH_ALLOWED_ORIGINS=https://www.kairozcrm.com.br,https://kairozcrm.com.br
PUBLIC_FORM_ALLOWED_ORIGINS=REPLACE_WITH_COMMA_SEPARATED_HTTPS_ORIGINS

# Evolution API
EVOLUTION_API_URL=REPLACE
EVOLUTION_API_KEY=REPLACE
EVOLUTION_WEBHOOK_SECRET=REPLACE

# Meta / Facebook
FACEBOOK_APP_ID=REPLACE
FACEBOOK_APP_SECRET=REPLACE
FACEBOOK_WEBHOOK_VERIFY_TOKEN=REPLACE
# Use o mesmo valor da chave que criptografou os tokens Meta atuais para evitar
# reconectar as páginas. Novos tokens Meta nunca usam a variável Google.
META_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_VALUE

# Google Calendar. Necessária somente se a integração Google for reativada.
# Durante uma rotação da chave Meta, ela pode ser mantida temporariamente como
# fallback de leitura dos tokens Meta antigos e removida após a reconexão.
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_CALENDAR_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_VALUE
GOOGLE_SHEETS_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_VALUE
GOOGLE_REFRESH_TOKEN=REPLACE
GOOGLE_SA_EMAIL=REPLACE
GOOGLE_SA_PRIVATE_KEY=REPLACE_WITH_PEM_USING_ESCAPED_NEWLINES

# Public capture, dashboards and outbound integrations
ANALISE_CREDITO_SHEET_ID=REPLACE
ANALISE_CREDITO_SHEET_TAB=REPLACE
APR_DASHBOARD_TOKEN=REPLACE_WITH_64_RANDOM_HEX
APR_META_ACCESS_TOKEN=REPLACE
APR_META_PIXEL_ID=REPLACE
APR_NOTIFY_EVOLUTION_INSTANCE=REPLACE
APR_NOTIFY_WHATSAPP=REPLACE
APR_SESSAO_ESTRATEGICA_SHEET_ID=REPLACE
APR_SESSAO_ESTRATEGICA_SHEET_TAB=REPLACE
APR_SESSION_STRATEGIC_SHEET_ID=REPLACE
APR_SESSION_STRATEGIC_SHEET_TAB=REPLACE
APR_SHEET_ID=REPLACE
APR_SHEET_TAB=REPLACE
CHATWOOT_ACCOUNT_ID=REPLACE
CHATWOOT_API_TOKEN=REPLACE
CHATWOOT_BASE_URL=REPLACE_WITH_HTTPS_URL
CHATWOOT_INBOX_ID=REPLACE
CONVEX_WEBHOOK_URL=REPLACE_WITH_ROTATED_HTTPS_URL
CONVEX_WEBHOOK_TOKEN=REPLACE_WITH_ROTATED_TOKEN
DISC_AI_MODEL=REPLACE
DISC_DASHBOARD_TOKEN=REPLACE_WITH_64_RANDOM_HEX
EVOLUTION_GROUP_OPERACIONAL=REPLACE
EVOLUTION_INSTANCE=REPLACE
META_ACCESS_TOKEN=REPLACE
META_CAPI_ACCESS_TOKEN=REPLACE
META_GRAPH_VERSION=REPLACE
META_PIXEL_ACCESS_TOKEN=REPLACE
META_PIXEL_ID=REPLACE
META_TEST_EVENT_CODE=REPLACE
OPENROUTER_API_KEY=REPLACE
SELLER_WHATSAPP=REPLACE

# Billing / email
MERCADOPAGO_ACCESS_TOKEN=REPLACE
MERCADOPAGO_WEBHOOK_SECRET=REPLACE
RESEND_API_KEY=REPLACE
