# Copy to a protected path on the machine performing the migration.
# The populated file must be mode 600 and must not be committed.

# Canonical PostgreSQL connection to the managed Supabase source. Percent-encode
# special characters in the password. Query/options are refused so sslmode or
# libpq options cannot override TLS verify-full. Use direct or session-pooler
# mode on port 5432; transaction pooler (6543) is refused.
SOURCE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Guardrails used by the source freeze/unfreeze scripts. Keep the project ref
# consistent with SOURCE_DB_URL; direct or session-pooler mode is required.
SOURCE_PROJECT_REF=uxttihjsxfowursjyult
SOURCE_EXPECTED_DATABASE=postgres
SOURCE_EXPECTED_DB_HOST=db.uxttihjsxfowursjyult.supabase.co
SOURCE_DB_SSL_ROOT_CERT=/etc/crm-supabase/source-db-ca.crt

# Protected directory where reversible cutover state is stored.
CUTOVER_STATE_DIR=/var/backups/crm-supabase/cutover-state

# Storage API copier used automatically by the production orchestrator
SOURCE_SUPABASE_URL=https://PROJECT_REF.supabase.co
SOURCE_SERVICE_ROLE_KEY=REPLACE
TARGET_SUPABASE_URL=https://api.kairozcrm.com.br
TARGET_SERVICE_ROLE_KEY=REPLACE
# Opcional: restringir ainda mais a copia. chat-media e sempre recusado pelos
# dois copiadores, mesmo se for incluido aqui. O default copia somente os tres
# buckets preservados: activity-attachments, avatars e team-avatars.
STORAGE_BUCKETS=activity-attachments,avatars,team-avatars

# Optional/manual contingency path through S3/rclone. These placeholders are
# not required by the automated production cutover.
SOURCE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SOURCE_S3_REGION=REPLACE
SOURCE_S3_ACCESS_KEY_ID=REPLACE
SOURCE_S3_SECRET_ACCESS_KEY=REPLACE
TARGET_S3_ENDPOINT=https://api.kairozcrm.com.br/storage/v1/s3
TARGET_S3_REGION=stub
TARGET_S3_ACCESS_KEY_ID=REPLACE
TARGET_S3_SECRET_ACCESS_KEY=REPLACE

# URL rewrite after restore
OLD_SUPABASE_PUBLIC_URL=https://PROJECT_REF.supabase.co
NEW_SUPABASE_PUBLIC_URL=https://api.kairozcrm.com.br
